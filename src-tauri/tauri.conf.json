{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "holzi",
  "version": "0.1.0",
  "identifier": "com.haex.holzi",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3030",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm generate"
  },
  "app": {
    "windows": [
      {
        "title": "Holzi",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:3030",
        "connect-src": "ipc: http://ipc.localhost http://localhost:3030 ws://localhost:3030",
        "font-src": "'self' data: http://localhost:3030",
        "img-src": "'self' asset: http://asset.localhost blob: data: http://localhost:3030",
        "script-src": "'self' 'unsafe-eval' http://localhost:3030",
        "style-src": "'self' 'unsafe-inline' http://localhost:3030",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
.vscode/
.idea/

# AI agent scratch — may hold credentials or session state.
# See specify init warning: keep out of the repository.
.claude/

# spaex advisory manifest lock
.spaex.json.lock
.spaex/install.lock

# Node
node_modules/

# Nuxt
.nuxt/
.output/
.data/
# `dist` is a symlink Nuxt generates as a convenience for `nuxt generate` — no trailing slash so the symlink itself is ignored.
dist

# Tauri (Rust build output)
src-tauri/target/
src-tauri/gen/

# Generated ts-rs bindings (regenerated from Rust; CI check runs `pnpm generate:ts-types`)
# Keeping them tracked lets the frontend import without a Rust build; the CI check
# fails if they drift from a fresh regeneration.

# Env
.env
.env.*
!.env.example

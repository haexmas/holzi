{
  "name": "holzi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "check:chat-state": "node scripts/check-chat-state.ts",
    "check:templates": "node scripts/check-vue-templates.ts",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo clippy --manifest-path src-tauri/Cargo.toml --no-default-features --all-targets -- -D warnings",
    "lint:all": "pnpm lint && pnpm lint:rust",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:cuda": "tauri dev -- --features llm-cuda",
    "tauri:dev:metal": "tauri dev -- --features llm-metal",
    "tauri:build": "tauri build",
    "tauri:build:cuda": "tauri build -- --features llm-cuda",
    "tauri:build:metal": "tauri build -- --features llm-metal",
    "generate:ts-types": "cd src-tauri && cargo test export_bindings -- --nocapture && cd .. && sed -i -E 's/[[:space:]]+$//' src/types/bindings/*.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.47.0",
    "@nuxt/icon": "2.5.1",
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "1.0.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-store": "^2.4.5",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "embla-carousel-vue": "^8.6.0",
    "marked": "^18.0.13",
    "nuxt": "4.5.2",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "shadcn-nuxt": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.43",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.133",
    "@nuxt/eslint": "^1.17.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  }
}
